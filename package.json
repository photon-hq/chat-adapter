{
  "name": "@photon-ai/chat-adapter",
  "version": "0.0.0",
  "description": "Photon adapter for Chat SDK: iMessage, SMS, WhatsApp, Telegram, and email through one Photon project",
  "keywords": [
    "adapter",
    "bot",
    "chat-adapter",
    "chat-sdk",
    "email",
    "imessage",
    "photon",
    "sms",
    "telegram",
    "whatsapp"
  ],
  "homepage": "https://github.com/photon-hq/chat-adapter",
  "bugs": {
    "url": "https://github.com/photon-hq/chat-adapter/issues"
  },
  "license": "Apache-2.0",
  "author": "photon",
  "repository": {
    "type": "git",
    "url": "https://github.com/photon-hq/chat-adapter.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.44.0",
    "mime-types": "^3.0.2",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "^4.44.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.5",
    "chat": "^4.44.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.91.0",
    "socket.io": "^4.8.4",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3",
    "ultracite": "8.1.1",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "chat": "^4.44.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.11.2"
}
